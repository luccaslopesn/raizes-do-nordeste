digraph navegacao_op {
  graph [rankdir=LR, fontname="Arial", fontsize=13, nodesep=0.28, ranksep=0.42, pad=0.15, compound=true, newrank=true];
  node  [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#222222", penwidth=1.3, fontname="Arial", fontsize=11, margin="0.12,0.06", height=0.4];
  edge  [color="#222222", penwidth=1.1, arrowsize=0.7, fontname="Arial", fontsize=9.5];

  subgraph cluster_op {
    label=<<b>Operação da loja</b>>; style="rounded,filled"; fillcolor="#f4f4f4"; color="#222222";
    O0 [label="Entrar com\nperfil + PIN"];
    OB [label="Balcão: novo pedido,\nentregar, cancelar"];
    OC [label="Cozinha:\nfila de preparo"];
    OG [label="Gestão: indicadores\ne auditoria"];
    PC [label="Painel de\nchamada (TV)"];
    O0 -> OB [label="atendente"]; O0 -> OC [label="cozinha"]; O0 -> OG [label="gerente"];
    OC -> PC [style=dotted, label="status"];
  }
}
