digraph navegacao_app {
  graph [rankdir=LR, fontname="Arial", fontsize=13, nodesep=0.28, ranksep=0.42, pad=0.15, compound=true, newrank=true];
  node  [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#222222", penwidth=1.3, fontname="Arial", fontsize=11, margin="0.12,0.06", height=0.4];
  edge  [color="#222222", penwidth=1.1, arrowsize=0.7, fontname="Arial", fontsize=9.5];

  subgraph cluster_app {
    label=<<b>App / Web do cliente</b>>; style="rounded,filled"; fillcolor="#f4f4f4"; color="#222222";
    U  [label="Escolher\nunidade"];
    CA [label="Cardápio\nda unidade"];
    CR [label="Carrinho"];
    EN [label="Entrar / Cadastro\n(consentimentos)"];
    PG [label="Pagamento"];
    AC [label="Acompanhar\npedido"];
    CO [label="Conta"];
    MP [label="Meus pedidos"];
    FI [label="Fidelidade"];
    PR [label="Promoções"];
    PV [label="Central de\nPrivacidade"];
    U -> CA -> CR -> PG;
    PG -> AC [label="aprovado"];
    PG -> PG [label="recusado /\nexpirado", style=dashed];
    CR -> EN [label="sem login"];
    EN -> CR [style=dashed];
    CO -> MP -> AC;
    CO -> FI; CO -> PR; CO -> PV;
    FI -> CR [label="usar\nrecompensa", style=dashed];
    {rank=same; CR; FI}
  }
}
